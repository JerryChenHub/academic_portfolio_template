---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'mentorship'>;
  heading?: 'h2' | 'h3';
}

const { entry, heading: Heading = 'h3' } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<article class="work-card mentorship-card">
  <a
    class="card-hit"
    href={withBase(`mentorship/${entry.id}/`)}
    aria-label={`Read about ${entry.data.title} mentorship`}
  />
  <div class="work-media">
    <img
      src={withBase(entry.data.thumbnail)}
      alt={entry.data.imageAlt}
      width="720"
      height="540"
      loading="lazy"
    />
  </div>
  <div class="work-copy">
    <div class="work-meta">
      <span>{entry.data.period}</span>
      <span>{entry.data.role}</span>
    </div>
    <Heading>{entry.data.title}</Heading>
    <p>{entry.data.summary}</p>
  </div>
</article>
