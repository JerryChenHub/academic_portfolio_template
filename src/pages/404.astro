---
import SiteLayout from '../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL;
---

<SiteLayout title="Page not found" description="The requested page could not be found." noindex>
  <section class="empty-page shell">
    <p class="eyebrow">404</p>
    <h1>Nothing here yet.</h1>
    <p>The page may have moved, or it may still be waiting to be written.</p>
    <a class="text-link" href={base}>Return home <span aria-hidden="true">→</span></a>
  </section>
</SiteLayout>
