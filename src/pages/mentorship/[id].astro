---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const mentorship = await getCollection('mentorship');
  return mentorship.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const landscapePhotos = entry.data.gallery.filter((photo) => photo.width >= photo.height);
const portraitPhotos = entry.data.gallery.filter((photo) => photo.width < photo.height);
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<SiteLayout
  title={`${entry.data.title} Mentorship`}
  description={entry.data.summary}
  active="mentorship"
  image={entry.data.image}
>
  <article class="detail-page shell mentorship-detail">
    <a class="back-link" href={withBase('mentorship/')}>
      <span aria-hidden="true">←</span> All mentorship
    </a>

    <header class="detail-header">
      <div class="work-meta">
        <span>{entry.data.period}</span>
        <span>{entry.data.role}</span>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="detail-summary">{entry.data.summary}</p>
    </header>

    <figure class="mentorship-hero">
      <img
        src={withBase(entry.data.image)}
        alt={entry.data.imageAlt}
        width="1600"
        height="1200"
        fetchpriority="high"
      />
      <figcaption>{entry.data.imageCaption}</figcaption>
    </figure>

    <div class="prose mentorship-prose">
      <Content />
    </div>

    <section class="mentorship-gallery-section" aria-labelledby="gallery-heading">
      <h2 id="gallery-heading" class="eyebrow">{entry.data.galleryHeading}</h2>
      <div class="mentorship-gallery">
        {landscapePhotos.map((photo) => (
          <figure>
            <a href={withBase(photo.image)} aria-label={`View full photo: ${photo.alt}`}>
              <img
                src={withBase(photo.image)}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                loading="lazy"
              />
            </a>
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <div class:list={["mentorship-moments", { "mentorship-moments-single": portraitPhotos.length === 0 }]}>
      {portraitPhotos.map((photo) => (
        <figure class="mentorship-group">
          <a href={withBase(photo.image)} aria-label={`View full photo: ${photo.alt}`}>
            <img
              src={withBase(photo.image)}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading="lazy"
            />
          </a>
          <figcaption>{photo.caption}</figcaption>
        </figure>
      ))}
      {entry.data.video && (
        <figure class:list={["mentorship-video", { "mentorship-video-landscape": entry.data.video.width > entry.data.video.height }]}>
          <video
            controls
            playsinline
            preload="none"
            poster={withBase(entry.data.video.poster)}
            width={entry.data.video.width}
            height={entry.data.video.height}
            aria-label={entry.data.video.caption}
            aria-describedby="experiment-caption"
          >
            <source src={withBase(entry.data.video.src)} type="video/mp4" />
            <a href={withBase(entry.data.video.src)}>Watch the video</a>
          </video>
          <figcaption id="experiment-caption">{entry.data.video.caption}</figcaption>
        </figure>
      )}
    </div>
  </article>
</SiteLayout>
