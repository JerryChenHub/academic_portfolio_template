---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { mae106Rover } from '../../data/site';

const withBase = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
const media = (name: string) => withBase(`media/mae106_rover/${name}`);
const cadViews = [
  {
    image: 'rover_cad.webp',
    alt: 'SolidWorks assembly of the rover with its tire air tank, chassis and wheels',
    caption: 'The full rover assembly.',
    width: 580,
    height: 888,
  },
  {
    image: 'steering_cad.webp',
    alt: 'CAD view of the front wheel steering linkage',
    caption: 'The front steering linkage.',
    width: 1342,
    height: 705,
  },
  {
    image: 'piston_cad.webp',
    alt: 'CAD detail of the angled pneumatic cylinder and its contact foot',
    caption: 'The piston and its contact foot.',
    width: 506,
    height: 902,
  },
];
const videos = [
  { file: 'video_test_1', label: 'Outdoor course test' },
  { file: 'video_test_2', label: 'Servo bench test' },
  { file: 'video_test_3', label: 'Solenoid bench test' },
];
---

<SiteLayout title="Pneumatic Rover · MAE 106" description={mae106Rover.summary} image={mae106Rover.image}>
  <article class="detail-page shell rover-project">
    <a class="back-link" href={withBase('#projects')}>
      <span aria-hidden="true">←</span> All projects
    </a>

    <header class="detail-header">
      <div class="work-meta"><span>{mae106Rover.context}</span></div>
      <h1>Pneumatic Rover</h1>
      <p class="detail-summary">A rover powered by compressed air, built to follow a course with two turns.</p>
      <p class="award">Second place in our group at the final competition</p>
      <div class="link-row detail-actions">
        <a href={mae106Rover.links[0].url} target="_blank" rel="noreferrer">
          GitHub<span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <section class="overview-grid" aria-labelledby="task-heading">
      <figure class="rover-figure rover-photo">
        <img src={media('rover_photo.webp')} alt={mae106Rover.imageAlt} width={mae106Rover.imageWidth} height={mae106Rover.imageHeight} fetchpriority="high" />
        <figcaption>Our finished rover. The tire on top stores the compressed air.</figcaption>
      </figure>
      <div class="overview-copy">
        <p class="eyebrow">The course</p>
        <h2 id="task-heading">Three straight sections.<br />Two turns.</h2>
        <p>
          For MAE 106, we built a rover that could travel 3 m, turn, continue for 15 m,
          turn again, and travel the final 3 m.
        </p>
        <ol class="route" aria-label="Course sequence">
          <li><strong>3 m</strong><span>then turn</span></li>
          <li><strong>15 m</strong><span>then turn</span></li>
          <li><strong>3 m</strong><span>to finish</span></li>
        </ol>
        <p>
          Air from an inflated tire drove a piston that pushed against the ground.
          A small compass measured heading with roughly 10° of error, while limit
          switches on the rear wheels measured distance.
        </p>
      </div>
    </section>

    <section class="role-summary" aria-labelledby="role-heading">
      <h2 id="role-heading">My role</h2>
      <p>
        I coordinated team tasks and testing, and helped design the chassis and steering
        in SolidWorks. I also 3D printed parts and wrote, tuned, and debugged the control code.
      </p>
    </section>

    <section class="testing-section" aria-labelledby="testing-heading">
      <h2 id="testing-heading">Testing the rover</h2>
      <div class="video-grid">
        {videos.map((video) => (
          <figure class="rover-figure">
            <video controls playsinline preload="none" poster={media(`${video.file}.webp`)} aria-label={video.label}>
              <source src={media(`${video.file}.mp4`)} type="video/mp4" />
              <a href={media(`${video.file}.mp4`)}>Watch {video.label.toLowerCase()}</a>
            </video>
            <figcaption>{video.label}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="rover-section" aria-labelledby="design-heading">
      <div class="section-copy">
        <h2 id="design-heading">Building the rover</h2>
        <p>
          We used a modular frame with printed parts, carbon fiber tubes, and wooden panels.
          Parts such as the steering linkage and piston mount could be removed and replaced
          as we tested the design.
        </p>
      </div>
      <div class="cad-grid">
        {cadViews.map((view) => (
          <figure class="rover-figure">
            <a href={media(view.image)} target="_blank" rel="noreferrer" aria-label={`Open ${view.caption.toLowerCase().replace(/\.$/, '')} at full size`}>
              <img src={media(view.image)} alt={view.alt} width={view.width} height={view.height} loading="lazy" />
            </a>
            <figcaption>{view.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="rover-section" aria-labelledby="control-heading">
      <div class="section-copy">
        <h2 id="control-heading">Getting back onto a straight path</h2>
        <p>
          The control code used wheel travel to track distance and the compass to read heading.
          I tuned a predefined steering sequence for turns and used PID steering to correct
          the heading on straight sections.
        </p>
        <p>
          We tested five proportional gains, with ten runs at each setting. Each test started
          with a sharp right turn followed by a 10 m straight run. A gain of 2.4 gave the lowest
          error score, which combined sideways drift with a penalty for leaving or nearly
          leaving the course.
        </p>
      </div>
      <figure class="rover-figure tuning-figure">
        <a href={media('control_tuning.webp')} target="_blank" rel="noreferrer" aria-label="Open the steering gain test chart at full size">
          <img src={media('control_tuning.webp')} alt="Test chart comparing lateral error and the penalized error score for five proportional gains, with the lowest score at Kp 2.4" width="2160" height="1440" loading="lazy" />
        </a>
        <figcaption>Steering gain tests after a sharp turn. These 10 m tests were separate from the full competition course.</figcaption>
      </figure>
    </section>

    <aside class="supporting-materials" aria-label="Checkpoint slides">
      <div class="link-row slide-links">
        <a href={withBase('slides/mae106_checkpoint_1.pptx')} download>Checkpoint 1 slides <span class="file-type">PPTX</span></a>
        <a href={withBase('slides/mae106_checkpoint_2.pptx')} download>Checkpoint 2 slides <span class="file-type">PPTX</span></a>
      </div>
    </aside>
  </article>
</SiteLayout>

<style>
  .back-link { margin-bottom: 42px; }
  .detail-summary { max-width: 680px; }
  .overview-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(28px, 5vw, 56px); margin-top: 42px; }
  .overview-copy h2, .section-copy h2 { margin-bottom: 18px; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(27px, 3.8vw, 36px); font-weight: 500; line-height: 1.2; letter-spacing: -0.025em; }
  .overview-copy p, .section-copy p, .role-summary p { color: var(--muted); }
  .overview-copy p:last-child, .section-copy p:last-child, .role-summary p { margin-bottom: 0; }
  .rover-figure { min-width: 0; margin: 0; }
  .rover-figure img, .rover-figure video { width: 100%; height: auto; border: 1px solid var(--line); border-radius: 3px; }
  .rover-figure a { display: block; }
  .rover-figure figcaption { margin-top: 10px; color: var(--muted); font-size: 13px; line-height: 1.6; }
  .route { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; margin: 24px 0; padding: 18px 0; border-block: 1px solid var(--line); }
  .route li + li { border-left: 1px solid var(--line); padding-left: 18px; }
  .route strong { display: block; font-size: clamp(22px, 3vw, 28px); font-weight: 500; }
  .route span { color: var(--muted); font-size: 12px; }
  .rover-section { margin-top: clamp(48px, 7vw, 72px); }
  .section-copy { max-width: 740px; }
  .role-summary { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 24px; align-items: baseline; margin-top: 32px; padding-block: 20px; border-block: 1px solid var(--line); }
  .role-summary h2 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: 23px; font-weight: 500; line-height: 1.3; }
  .role-summary p { max-width: 760px; font-size: 15px; }
  .testing-section { margin-top: 30px; }
  .testing-section h2 { margin-bottom: 16px; font-family: Georgia, 'Times New Roman', serif; font-size: 25px; font-weight: 500; }
  .cad-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 28px; }
  .cad-grid img { aspect-ratio: 1; object-fit: contain; background: #fff; padding: 12px; }
  .tuning-figure { max-width: 780px; margin-top: 28px; }
  .supporting-materials { margin-top: 36px; padding-block: 16px; border-block: 1px solid var(--line); color: var(--muted); font-size: 13px; }
  .video-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .video-grid video { display: block; aspect-ratio: 4 / 3; object-fit: contain; background: #171916; }
  .slide-links { font-size: 13px; }
  .file-type { font-size: 10px; color: var(--muted); }
  @media (max-width: 700px) {
    .overview-grid { grid-template-columns: 1fr; }
    .rover-photo { max-width: 480px; }
    .role-summary { grid-template-columns: 1fr; gap: 10px; padding-block: 16px; }
    .cad-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 16px; }
    .cad-grid .rover-figure:first-child { grid-column: 1 / -1; max-width: 340px; width: 100%; justify-self: center; }
    .video-grid { grid-template-columns: 1fr; max-width: 440px; }
  }
</style>
