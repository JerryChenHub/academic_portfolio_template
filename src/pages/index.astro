---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile, project, socialLinks } from '../data/site';

const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<SiteLayout description={`${profile.name} works on robotics, planning, and foundation models.`} active="home">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">{profile.eyebrow}</p>
      <h1>{profile.name}</h1>
      <p class="hero-intro">{profile.introduction}</p>
      <div class="bio-copy">
        {profile.biography.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <nav class="link-row social-links" aria-label="Profile links">
        {
          socialLinks.map((link) => (
            <a
              href={link.url}
              target={link.url.startsWith('http') ? '_blank' : undefined}
              rel={link.url.startsWith('http') ? 'noreferrer' : undefined}
            >
              {link.label}<span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </nav>
    </div>
    <figure class="portrait-wrap">
      <img
        class="portrait"
        src={withBase(profile.portrait)}
        alt={profile.portraitAlt}
        width="520"
        height="520"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="section shell" aria-labelledby="research-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="research-heading">Research</h2>
      </div>
      <a class="text-link" href={withBase('research/')}>View all <span aria-hidden="true">→</span></a>
    </div>

    <div class="work-list">
      {
        research.map((item) => (
          <article class="work-card">
            <a
              class="card-hit"
              href={withBase(`research/${item.id}/`)}
              aria-label={`Read ${item.data.title}`}
            />
            <div class="work-media">
              <img
                src={withBase(item.data.image)}
                alt={item.data.imageAlt}
                width="720"
                height="450"
                loading="lazy"
              />
            </div>
            <div class="work-copy">
              <div class="work-meta">
                <span>{item.data.year}</span>
                <span>{item.data.venue}</span>
              </div>
              <h3>{item.data.title}</h3>
              <p>{item.data.summary}</p>
              <p class="authors">
                {item.data.authors.map((author, index) => (
                  <>
                    {index > 0 && ', '}
                    {author === profile.name ? <strong>{author}</strong> : author}
                  </>
                ))}
              </p>
              {item.data.award && <p class="award">{item.data.award}</p>}
              <div class="link-row card-actions">
                {item.data.links.slice(0, 2).map((link) => (
                  <a href={link.url} target="_blank" rel="noreferrer">
                    {link.label}<span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section shell" id="projects" aria-labelledby="projects-heading">
    <div class="section-heading compact-heading">
      <div>
        <p class="eyebrow">Making</p>
        <h2 id="projects-heading">Projects</h2>
      </div>
    </div>

    <article class="project-row">
      <div class="project-media">
        <img
          src={withBase(project.image)}
          alt={project.imageAlt}
          width="720"
          height="450"
          loading="lazy"
        />
      </div>
      <div class="project-copy">
        <p class="work-meta"><span>{project.context}</span></p>
        <h3>{project.title}</h3>
        <p>{project.summary}</p>
        <div class="link-row">
          {
            project.links.map((link) => (
              <a href={link.url} target="_blank" rel="noreferrer">
                {link.label}<span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </div>
    </article>
  </section>
</SiteLayout>
