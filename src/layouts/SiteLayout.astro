---
import '../styles/global.css';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description: string;
  active?: 'home' | 'research' | 'mentorship';
  image?: string;
  noindex?: boolean;
}

const { title, description, active, image, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : profile.name;
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase(image ?? 'og.png'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={withBase('')} aria-label={`${profile.name} home`}>
          {profile.name}
        </a>
        <nav class="main-nav" aria-label="Primary navigation">
          <a href={withBase('')} aria-current={active === 'home' ? 'page' : undefined}>Home</a>
          <a
            href={withBase('research/')}
            aria-current={active === 'research' ? 'page' : undefined}>Research</a
          >
          <a
            href={withBase('mentorship/')}
            aria-current={active === 'mentorship' ? 'page' : undefined}>Mentorship</a
          >
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <span>Last updated {profile.updated}</span>
        <span>Built with Astro</span>
      </div>
    </footer>
  </body>
</html>
